# ===================================================================
# SHARED ENVIRONMENT CONFIGURATION - DISTRIBUTED DEPLOYMENT
# AWS Lightsail Multi-Instance Architecture
# ===================================================================

# ===================================================================
# STATIC IP ADDRESSES (AWS Lightsail)
# ===================================================================
# Replace with DNS names in production for better reliability
EUREKA_GATEWAY_IP=54.217.247.163
SERVICES_IP=35.153.96.103
MYSQL_IP=3.147.141.101
KAFKA_IP=3.147.109.193
REDIS_IP=98.89.238.241
FRONTEND_IP=54.154.129.84

# ===================================================================
# EUREKA SERVER CONFIGURATION
# ===================================================================
EUREKA_URL=http://54.217.247.163:8761/eureka/
EUREKA_HOSTNAME=54.217.247.163
EUREKA_PORT=8761

# ===================================================================
# API GATEWAY CONFIGURATION
# ===================================================================
API_GATEWAY_URL=http://54.217.247.163:8082
API_GATEWAY_PORT=8082

# ===================================================================
# MYSQL DATABASE CONFIGURATION
# ===================================================================
MYSQL_HOST=3.147.141.101
MYSQL_PORT=3306
MYSQL_DATABASE=chatdb
MYSQL_USER=chatuser
MYSQL_PASSWORD=chatpass123
MYSQL_ROOT_PASSWORD=rootpass123

# Full JDBC URL
MYSQL_URL=jdbc:mysql://3.147.141.101:3306/chatdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# ===================================================================
# KAFKA CONFIGURATION
# ===================================================================
KAFKA_HOST=3.147.109.193
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=3.147.109.193:9092

# Kafka Topics (auto-created by application)
KAFKA_TOPIC_MESSAGE_SENT=chat.message.sent
KAFKA_TOPIC_MESSAGE_DELIVERED=chat.message.delivered
KAFKA_TOPIC_MESSAGE_READ=chat.message.read
KAFKA_TOPIC_USER_PRESENCE=chat.user.presence

# ===================================================================
# REDIS CONFIGURATION
# ===================================================================
REDIS_HOST=98.89.238.241
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ===================================================================
# USER SERVICE CONFIGURATION
# ===================================================================
USER_SERVICE_HOST=35.153.96.103
USER_SERVICE_PORT=8081
USER_SERVICE_URL=http://35.153.96.103:8081

# ===================================================================
# MESSAGE SERVICE CONFIGURATION
# ===================================================================
MESSAGE_SERVICE_HOST=35.153.96.103
MESSAGE_SERVICE_PORT=8083
MESSAGE_SERVICE_URL=http://35.153.96.103:8083

# WebSocket URL
WEBSOCKET_URL=ws://35.153.96.103:8083/ws

# ===================================================================
# FRONTEND CONFIGURATION
# ===================================================================
FRONTEND_URL=http://54.154.129.84
FRONTEND_PORT=80

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
CORS_ALLOWED_ORIGINS=http://54.154.129.84,http://localhost:4200

# ===================================================================
# JVM HEAP SETTINGS
# ===================================================================
# Eureka
EUREKA_JAVA_OPTS=-Xmx256m -Xms128m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# API Gateway
GATEWAY_JAVA_OPTS=-Xmx256m -Xms128m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# User Service
USER_SERVICE_JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Message Service
MESSAGE_SERVICE_JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ===================================================================
# SPRING PROFILES
# ===================================================================
SPRING_PROFILES_ACTIVE=docker

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CHATAPP=DEBUG

# ===================================================================
# DOCKER HUB REPOSITORY
# ===================================================================
DOCKER_REGISTRY=rakes9146
DOCKER_TAG=distributed

# Image Names
EUREKA_IMAGE=rakes9146/chat-eureka:distributed
GATEWAY_IMAGE=rakes9146/chat-api-gateway:distributed
USER_SERVICE_IMAGE=rakes9146/chat-user-service:distributed
MESSAGE_SERVICE_IMAGE=rakes9146/chat-message-service:distributed
FRONTEND_IMAGE=rakes9146/chat-frontend:distributed

# ===================================================================
# DNS MIGRATION PLAN (FUTURE)
# ===================================================================
# Once you register a domain, replace IPs with DNS names:
#
# EUREKA_HOSTNAME=eureka.yourdomain.com
# API_GATEWAY_URL=http://api.yourdomain.com
# MYSQL_HOST=mysql.yourdomain.com
# KAFKA_BOOTSTRAP_SERVERS=kafka.yourdomain.com:9092
# REDIS_HOST=redis.yourdomain.com
# FRONTEND_URL=https://chat.yourdomain.com
#
# Benefits:
# - No code changes if IPs change
# - Better for SSL certificates
# - Professional appearance
# - Load balancing support
#
# ===================================================================
# AWS LIGHTSAIL STATIC IP CONFIGURATION
# ===================================================================
# To ensure IPs don't change:
# 1. Go to Lightsail Console
# 2. Click on each instance
# 3. Networking tab -> Create static IP
# 4. Attach static IP to instance
