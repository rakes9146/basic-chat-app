# ===================================================================
# MESSAGE SERVICE DOCKERFILE - DISTRIBUTED DEPLOYMENT
# Instance: User + Message Services (2GB Lightsail)
# JVM Heap: -Xmx512m -Xms256m
# ===================================================================

# ----- BUILD STAGE -----
FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /build
COPY ../../message-service/pom.xml .
COPY ../../message-service/src ./src
RUN mvn clean package -DskipTests

# ----- RUNTIME STAGE -----
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Copy JAR from build stage
COPY --from=build /build/target/*.jar app.jar

# Set default JVM options (can be overridden via JAVA_OPTS env var)
ENV JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"

# Expose Message Service port
EXPOSE 8083

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8083/actuator/health || exit 1

# Run application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
